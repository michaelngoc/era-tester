NEXT_PUBLIC_APP_URL="https://your-vercel-domain.vercel.app"
JWT_SECRET="your_jwt_secret_here"
ADMIN_INITIAL_EMAIL="admin@eraweb.io"

# PostgreSQL Database (Dedicated Isolated Schema & User)
PGHOST=180.93.182.185
PGPORT=5432
PGDATABASE=eraweb_master
ERA_TESTER_USER=era_tester_user
ERA_TESTER_PASSWORD="your_tester_password"
PG_SCHEMA=era_tester
PG_SSL=true

# AWS S3 & SES
AWS_REGION="ap-southeast-1"
AWS_BUCKET="eraweb"
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_SES_ACCESS_KEY_ID="your_ses_access_key"
AWS_SES_SECRET_ACCESS_KEY="your_ses_secret_key"
AWS_SES_FROM_EMAIL="no-reply@mailer.eraweb.io"

# GitHub Webhook Secret
GITHUB_WEBHOOK_SECRET="your_webhook_secret"
